# Google Cloud / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Datadog Configuration
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_app_key_here
DD_SITE=datadoghq.com
DD_SERVICE=llm-observability-demo
DD_ENV=development
DD_VERSION=1.0.0

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Telemetry Buffer Configuration
TELEMETRY_BUFFER_MAX_MB=10
TELEMETRY_FLUSH_INTERVAL_MS=5000

# Admin API Key (for load simulation and admin endpoints)
ADMIN_API_KEY=generate_random_key_here
